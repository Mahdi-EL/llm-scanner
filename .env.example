# ── Core ──────────────────────────────────────────────────────
# Random string, min 32 chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── AI Providers ──────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...   # optional

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://llmscanner.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Admin Account (optional seed) ────────────────────────────
# If set, an admin account is auto-created on first startup
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@llmscanner.com

# ── Database ──────────────────────────────────────────────────
# Local: leave default. Railway: set to /data/llmscanner.db with volume at /data
DB_PATH=results/llmscanner.db

# ── Email (Resend) ────────────────────────────────────────────
# Get at: https://resend.com
RESEND_API_KEY=re_...

# ── Payments (Stripe) ─────────────────────────────────────────
# Get at: https://stripe.com/docs/keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
