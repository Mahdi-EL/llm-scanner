# Copy to .env and fill in. Every variable is optional unless marked REQUIRED.

# ── Core ──────────────────────────────────────────────────────
# Set ENV=production on real hosts (Railway sets RAILWAY_ENVIRONMENT, which also
# counts). In production the API refuses to start without a real SECRET_KEY.
ENV=development
# REQUIRED in production. Random, 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and makes stored target keys unreadable
# (unless ENCRYPTION_KEY is set separately).
SECRET_KEY=
# Optional Fernet key for encrypting stored target API keys. Defaults to a key
# derived from SECRET_KEY. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ── Storage ───────────────────────────────────────────────────
# On Railway, attach a volume at /data and use /data/llmscanner.db, or every
# deploy starts with an empty database.
DB_PATH=results/llmscanner.db
# Reports are built from the database on download. This folder (default: "reports" next to the
# database) only holds files written by older versions.
REPORTS_DIR=

# ── LLM providers ─────────────────────────────────────────────
# REQUIRED for simulation scans and for grading every scan.
GROQ_API_KEY=
# Defaults follow the models Groq serves today; unavailable models fall back automatically.
DEFAULT_MODEL=qwen/qwen3.8-27b
# The judge grades every reply. A different model family than your targets avoids self-grading bias.
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_FALLBACK_MODEL=qwen/qwen3.8-27b
# Use another key or an OpenAI-compatible endpoint for the judge:
JUDGE_API_KEY=
JUDGE_BASE_URL=
# Plain refusals the rule detectors cleared are graded without a judge call (saves most calls on
# well-defended targets). Set to 0 to send every reply to the judge.
JUDGE_SKIP_CLEAR_REFUSALS=1
# low | medium | high for gpt-oss judges; empty = provider default. "low" costs far fewer tokens.
JUDGE_REASONING_EFFORT=
# Price per million tokens, for `python backend/cli.py costs` (check your provider's current prices).
MODEL_PRICE_IN_PER_M=
MODEL_PRICE_OUT_PER_M=

# ── Scans ─────────────────────────────────────────────────────
MAX_CONCURRENT_SCANS=3       # scans running at once (others wait in the queue)
SCAN_CONCURRENCY=4           # attacks in flight within one scan
TARGET_TIMEOUT=30            # seconds per call to a target
MAX_CONSECUTIVE_ERRORS=25    # stop a scan when the target looks down
MAX_ERROR_PERCENT=50         # fail a scan when more than this % of attacks errored
QUICK_SCAN_PER_CATEGORY=5    # attacks per category in a quick scan
FREE_QUICK_SCANS_ONLY=0      # 1: Free accounts run quick scans only (full scans cost ~10x)
SCAN_RETENTION_DAYS=0        # delete finished scans this many days old (0: keep until their owner deletes them)
PRO_SEATS=5                  # people per workspace on Pro, owner included (Free 1, Enterprise no limit)
LEAK_CHECKS_PER_DAY=300      # free no-signup checks (20 model calls each) across all visitors per day
GATEWAY_TIMEOUT=120          # firewall gateway: seconds the model's API may take
GATEWAY_CONCURRENCY=16       # gateway requests in flight at once; the rest wait
GATEWAY_BLOCK_MESSAGE=       # reply sent instead of a blocked request (default: a short refusal)
FREE_REMEDIATION_DAILY=10    # hardened-prompt suggestions per day (PRO_ and ENTERPRISE_ too)
FREE_SCAN_LIMIT=10           # scans per month on each plan
PRO_SCAN_LIMIT=200
# Development only: allow scanning http://localhost targets. Ignored in production.
ALLOW_PRIVATE_TARGETS=false

# ── Web ───────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emails, share links and Stripe redirects).
APP_URL=http://localhost:3000
# Proxies in front of the API: rate limits use the X-Forwarded-For entry this many places from the right
# (entries further left are written by the client). Defaults to 1 on Railway, Heroku, Render and Fly, else 0.
# Add one per extra proxy you put in front, e.g. 2 behind Cloudflare on Railway.
# TRUSTED_PROXY_HOPS=1
LOG_LEVEL=INFO
# Error tracking (needs `pip install sentry-sdk`).
SENTRY_DSN=
# Block scans until the user confirms their email (needs RESEND_API_KEY).
REQUIRE_EMAIL_VERIFICATION=false

# ── Admin account (optional seed, created once) ───────────────
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@llmscanner.com

# ── Email (Resend: https://resend.com) ────────────────────────
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
FROM_EMAIL=LLM Scanner <noreply@yourdomain.com>

# ── Payments (Stripe: https://stripe.com/docs/keys) ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=          # optional: yearly prices show a Monthly/Yearly switch
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=
STRIPE_TRIAL_DAYS=0
