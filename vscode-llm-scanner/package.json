{
  "name": "llm-scanner",
  "displayName": "LLM Scanner",
  "description": "Scan the system prompts in your code for prompt injection, jailbreaks and data leaks",
  "version": "1.2.1",
  "publisher": "MahdiEL",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Mahdi-EL/llm-scanner" },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Linters", "Other"],
  "keywords": ["security", "AI", "LLM", "prompt injection"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "llmscanner.scanFile",   "title": "Scan This File",           "category": "LLM Scanner" },
      { "command": "llmscanner.scanPrompt", "title": "Scan Selected Text",       "category": "LLM Scanner" },
      { "command": "llmscanner.showReport", "title": "Open Last Report",         "category": "LLM Scanner" },
      { "command": "llmscanner.setApiKey",  "title": "Set API Key",              "category": "LLM Scanner" }
    ],
    "menus": {
      "editor/context": [
        { "command": "llmscanner.scanFile",   "group": "llmscanner" },
        { "command": "llmscanner.scanPrompt", "group": "llmscanner", "when": "editorHasSelection" }
      ]
    },
    "configuration": {
      "title": "LLM Scanner",
      "properties": {
        "llmscanner.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of your LLM Scanner API"
        },
        "llmscanner.appUrl": {
          "type": "string",
          "default": "",
          "description": "URL of the LLM Scanner web app, used by \"Open Last Report\""
        },
        "llmscanner.categories": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["direct_override", "extraction", "social_engineering", "boundary_testing"],
          "description": "Attack categories to run (empty = all 22). Fewer categories make scans faster and cheaper."
        },
        "llmscanner.quickScan": {
          "type": "boolean",
          "default": true,
          "description": "Run quick scans: about 5 attacks per category, from basic to advanced. Turn off to send every attack in the chosen categories (a full scan, best before a release; Free plans may be limited to quick scans)."
        },
        "llmscanner.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "Scan a file's system prompt when you save it, if the prompt changed since its last scan (each scan counts toward your plan's monthly limit)"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/extract.test.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  }
}
